<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/splashscreen"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:background="#000000"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical">
		<ImageView
			android:id="@+id/splashicon"
			android:layout_width="121dp"
			android:layout_height="121dp"
			android:src="@drawable/elicia_icon"
			android:scaleType="fitXY" />
		<TextView
			android:id="@+id/appname"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingTop="8dp"
			android:text="@string/app_name"
			android:textSize="30sp"
			android:textStyle="bold"
			android:textColor="#FFFFFF" />
		<TextView
			android:id="@+id/appinfo"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:text="Lightweight open source\nvirtual assistant"
			android:textSize="14sp"
			android:textColor="#BDBDBD" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/background"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="horizontal">
		<LinearLayout
			android:id="@+id/elicia_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/toolbar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="8dp"
				android:layout_marginRight="8dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/accpreview_system"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:padding="8dp"
					android:textSize="12sp"
					android:textColor="#000000" />
				<LinearLayout
					android:id="@+id/accountbg"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<ImageView
						android:id="@+id/account_button"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:src="@drawable/ic_account"
						android:scaleType="centerCrop"
						android:elevation="2dp" />
					<LinearLayout
						android:id="@+id/acctext_button"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:background="#283593"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:visibility="gone">
						<TextView
							android:id="@+id/acctext"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_margin="8dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="E"
							android:textSize="14sp"
							android:textColor="#FFFFFF" />
					</LinearLayout>
				</LinearLayout>
				<LinearLayout
					android:id="@+id/appbeta_namelayout"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/elicia_data"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:padding="8dp"
						android:textSize="12sp"
						android:textColor="#000000" />
					<TextView
						android:id="@+id/app_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="@string/app_name"
						android:textSize="20sp"
						android:textStyle="bold"
						android:textColor="#EEEEEE"
						android:layout_weight="1" />
					<LinearLayout
						android:id="@+id/previewmodel_background"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/preview_model"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingLeft="6dp"
							android:paddingTop="2dp"
							android:paddingRight="6dp"
							android:paddingBottom="2dp"
							android:textSize="11sp"
							android:textColor="#BDBDBD" />
					</LinearLayout>
				</LinearLayout>
				<ImageView
					android:id="@+id/newconversation_button"
					android:layout_width="35dp"
					android:layout_height="35dp"
					android:src="@drawable/icon_newconversation"
					android:scaleType="fitXY" />
			</LinearLayout>
			<TextView
				android:id="@+id/system_account"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:textSize="12sp"
				android:textColor="#FFFFFF" />
			<TextView
				android:id="@+id/system_model"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:text="bawaan"
				android:textSize="12sp"
				android:textColor="#000000" />
			<TextView
				android:id="@+id/apptheme_system"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:textSize="12sp"
				android:textColor="#000000" />
			<FrameLayout
				android:id="@+id/listchat_screen"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_marginLeft="8dp"
				android:layout_marginRight="8dp"
				android:orientation="vertical"
				android:layout_weight="1">
				<LinearLayout
					android:id="@+id/welcome_background"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_gravity="center_horizontal|center_vertical">
					<LinearLayout
						android:id="@+id/inoring"
						android:layout_width="140dp"
						android:layout_height="140dp"
						android:layout_margin="8dp"
						android:padding="8dp"
						android:orientation="vertical" />
					<TextView
						android:id="@+id/welcome_user"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:textSize="30sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:alpha="1.0" />
					<TextView
						android:id="@+id/welcome_message"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:textSize="14sp"
						android:textColor="#9E9E9E" />
				</LinearLayout>
				<ListView
					android:id="@+id/flowchat_background"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="4dp"
					android:layout_marginRight="4dp"
					android:choiceMode="none"
					android:layout_weight="1"
					android:divider="@null"
					android:fadingEdgeLength="35dp"
					android:requiresFadingEdge="vertical"
					android:visibility="gone"
					tools:listitem="@layout/flowchat_design" />
				<LinearLayout
					android:id="@+id/scrolldown_button"
					android:layout_width="70dp"
					android:layout_height="40dp"
					android:layout_marginBottom="9dp"
					android:padding="8dp"
					android:background="#212121"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_gravity="center_horizontal|bottom"
					android:visibility="gone"
					android:elevation="3dp">
					<ImageView
						android:id="@+id/scrolldwon_icon"
						android:layout_width="25dp"
						android:layout_height="25dp"
						android:src="@drawable/ic_go_back"
						android:scaleType="fitXY"
						android:rotation="270" />
				</LinearLayout>
			</FrameLayout>
			<LinearLayout
				android:id="@+id/input_background"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="12dp"
				android:layout_marginRight="12dp"
				android:layout_marginBottom="12dp"
				android:padding="4dp"
				android:background="#212121"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:elevation="5dp">
				<EditText
					android:id="@+id/input_question"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="8dp"
					android:layout_marginTop="8dp"
					android:layout_marginRight="8dp"
					android:padding="8dp"
					android:textSize="14sp"
					android:textColor="#EEEEEE"
					android:textColorHint="#9E9E9E" />
				<LinearLayout
					android:id="@+id/inputquestion_background"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="right|bottom"
					android:orientation="horizontal"
					android:layout_gravity="right">
					<ImageView
						android:id="@+id/clear_button"
						android:layout_width="23dp"
						android:layout_height="23dp"
						android:layout_marginRight="2dp"
						android:layout_marginBottom="8dp"
						android:src="@drawable/ic_clear"
						android:scaleType="fitXY"
						android:visibility="gone" />
					<TextView
						android:id="@+id/mic_system"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:padding="8dp"
						android:text="0"
						android:textSize="12sp"
						android:textColor="#000000"
						android:alpha="0.0" />
					<ImageView
						android:id="@+id/micquestion_button"
						android:layout_width="29dp"
						android:layout_height="29dp"
						android:layout_marginRight="4dp"
						android:layout_marginBottom="4dp"
						android:src="@drawable/icon_mic"
						android:scaleType="fitXY" />
					<ImageView
						android:id="@+id/directquestion_button"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:padding="8dp"
						android:src="@drawable/ic_model"
						android:scaleType="fitXY" />
					<ImageView
						android:id="@+id/sendquestion_button"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:padding="8dp"
						android:src="@drawable/ic_send"
						android:scaleType="fitXY"
						android:visibility="gone" />
					<LinearLayout
						android:id="@+id/progress_background"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_marginLeft="4dp"
						android:background="#363637"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:visibility="gone">
						<ProgressBar
							android:id="@+id/progress"
							android:layout_width="25dp"
							android:layout_height="25dp"
							android:layout_margin="8dp"
							android:indeterminate="false"
							style="?android:progressBarStyle"
							android:layout_gravity="left|center_vertical"
							android:alpha="1.0" />
					</LinearLayout>
					<ImageView
						android:id="@+id/shutup_button"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_marginLeft="4dp"
						android:padding="8dp"
						android:background="#363637"
						android:src="@drawable/icon_stop"
						android:scaleType="fitXY"
						android:visibility="gone" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/account_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_horizontal|top"
			android:orientation="vertical"
			android:visibility="gone">
			<TextView
				android:id="@+id/system_image"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:text="default"
				android:textSize="12sp"
				android:textColor="#000000" />
			<TextView
				android:id="@+id/language_system"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:textSize="12sp"
				android:textColor="#000000" />
			<LinearLayout
				android:id="@+id/userpreview_background"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="21dp"
				android:paddingBottom="21dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_gravity="center_horizontal|center_vertical"
				android:elevation="7dp">
				<ImageView
					android:id="@+id/accimage_preview"
					android:layout_width="186dp"
					android:layout_height="186dp"
					android:src="@drawable/ic_account"
					android:scaleType="centerCrop"
					android:layout_gravity="center_horizontal|center_vertical" />
				<LinearLayout
					android:id="@+id/acctext_background"
					android:layout_width="186dp"
					android:layout_height="186dp"
					android:padding="8dp"
					android:background="#283593"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:visibility="gone">
					<TextView
						android:id="@+id/acctext_preview"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="E"
						android:textSize="80sp"
						android:textColor="#FFFFFF" />
				</LinearLayout>
				<TextView
					android:id="@+id/username_preview"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="16dp"
					android:layout_marginTop="10dp"
					android:layout_marginRight="16dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="IqwanoINO"
					android:textSize="25sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:singleLine="true"
					android:layout_gravity="center_horizontal|center_vertical" />
				<TextView
					android:id="@+id/userinfo_preview"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="16dp"
					android:layout_marginRight="16dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="Hi there Welcome to Elicia AI"
					android:textSize="14sp"
					android:textColor="#BDBDBD"
					android:lines="2"
					android:layout_gravity="center_horizontal|center_vertical" />
			</LinearLayout>
			<ScrollView
				android:id="@+id/setting_scrollbackground"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:fadingEdgeLength="60dp"
				android:requiresFadingEdge="vertical">
				<LinearLayout
					android:id="@+id/setting_background"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:paddingLeft="10dp"
					android:paddingTop="8dp"
					android:paddingRight="10dp"
					android:paddingBottom="8dp"
					android:orientation="vertical"
					android:visibility="gone">
					<TextView
						android:id="@+id/title_settingscreen"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:paddingTop="8dp"
						android:paddingRight="8dp"
						android:text="Settings"
						android:textSize="25sp"
						android:textColor="#FFFFFF" />
					<TextView
						android:id="@+id/subtitle_settingscreen"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:paddingRight="8dp"
						android:paddingBottom="8dp"
						android:text="Create and customize your UI"
						android:textSize="14sp"
						android:textColor="#FFFFFF" />
					<LinearLayout
						android:id="@+id/language_setting_background"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="11dp"
						android:padding="14dp"
						android:background="#424242"
						android:orientation="vertical">
						<TextView
							android:id="@+id/settitle_language"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Language"
							android:textSize="18sp"
							android:textColor="#FFFFFF" />
						<TextView
							android:id="@+id/lang_selected"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingTop="4dp"
							android:gravity="left|center_vertical"
							android:text="English"
							android:textSize="14sp"
							android:textColor="#FFFFFF" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/theme_setting_background"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:padding="14dp"
						android:background="#424242"
						android:orientation="vertical">
						<TextView
							android:id="@+id/settitle_theme"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Theme"
							android:textSize="18sp"
							android:textColor="#FFFFFF" />
						<TextView
							android:id="@+id/subtitle_theme"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="10dp"
							android:gravity="left|center_vertical"
							android:text="Use it to change App theme"
							android:textSize="14sp"
							android:textColor="#9E9E9E"
							android:alpha="0.7" />
						<LinearLayout
							android:id="@+id/switch_theme_background"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:layout_marginBottom="16dp"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal">
							<LinearLayout
								android:id="@+id/setbackground_theme"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginRight="8dp"
								android:orientation="vertical"
								android:layout_weight="1">
								<TextView
									android:id="@+id/setname_theme"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:paddingTop="8dp"
									android:paddingRight="8dp"
									android:text="Dark theme"
									android:textSize="15sp"
									android:textColor="#FFFFFF" />
								<TextView
									android:id="@+id/subname_theme"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:paddingTop="2dp"
									android:paddingRight="8dp"
									android:paddingBottom="8dp"
									android:text="Make the app theme dark"
									android:textSize="12sp"
									android:textColor="#9E9E9E"
									android:alpha="0.7" />
							</LinearLayout>
							<Switch
								android:id="@+id/switch_theme"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginRight="8dp"
								android:paddingLeft="1dp"
								android:paddingTop="3dp"
								android:paddingRight="1dp"
								android:paddingBottom="3dp"
								android:textSize="14sp"
								android:textColor="#FFFFFF"
								android:scaleX="1.1"
								android:scaleY="1.1" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/switch_account_background"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="horizontal">
							<LinearLayout
								android:id="@+id/setbackground_account"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginRight="8dp"
								android:orientation="vertical"
								android:layout_weight="1">
								<TextView
									android:id="@+id/setname_account"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:paddingTop="8dp"
									android:paddingRight="8dp"
									android:text="Account Picture"
									android:textSize="15sp"
									android:textColor="#FFFFFF" />
								<TextView
									android:id="@+id/subname_account"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginRight="10dp"
									android:paddingTop="2dp"
									android:paddingRight="8dp"
									android:paddingBottom="8dp"
									android:text="Turning this on will change the Account display to Image"
									android:textSize="11sp"
									android:textColor="#9E9E9E"
									android:alpha="0.7" />
							</LinearLayout>
							<Switch
								android:id="@+id/switch_account"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginRight="8dp"
								android:paddingLeft="1dp"
								android:paddingTop="3dp"
								android:paddingRight="1dp"
								android:paddingBottom="3dp"
								android:textSize="14sp"
								android:textColor="#FFFFFF"
								android:scaleX="1.1"
								android:scaleY="1.1" />
						</LinearLayout>
					</LinearLayout>
					<TextView
						android:id="@+id/spacebar_settingscreen"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:padding="8dp"
						android:textSize="12sp"
						android:textColor="#000000"
						android:layout_weight="1" />
				</LinearLayout>
			</ScrollView>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/textselection_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="12dp"
			android:orientation="vertical"
			android:visibility="gone">
			<TextView
				android:id="@+id/system_pertanyaan"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="8dp"
				android:textSize="12sp"
				android:textColor="#000000" />
			<LinearLayout
				android:id="@+id/toolbar_textselection_screen"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="left|center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/goback_button_textselectionscreen"
					android:layout_width="28dp"
					android:layout_height="28dp"
					android:src="@drawable/ic_go_back"
					android:scaleType="fitXY" />
				<TextView
					android:id="@+id/textseletction_title"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="8dp"
					android:text="Select Text"
					android:textSize="25sp"
					android:textStyle="bold"
					android:textColor="#BDBDBD" />
			</LinearLayout>
			<ScrollView
				android:id="@+id/textselection_vscrollbackground"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_marginTop="8dp">
				<LinearLayout
					android:id="@+id/textselection_basebackground"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:gravity="left|top"
					android:orientation="vertical">
					<TextView
						android:id="@+id/system_jawaban"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="16sp"
						android:textColor="#FFFFFF" />
				</LinearLayout>
			</ScrollView>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/livechat_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/liverespone_background"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1">
				<LinearLayout
					android:id="@+id/liveresponse_animation"
					android:layout_width="221dp"
					android:layout_height="221dp"
					android:padding="8dp"
					android:background="#FFFFFF"
					android:orientation="vertical"
					android:elevation="8dp" />
				<LinearLayout
					android:id="@+id/livepaused_background"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="21dp"
					android:layout_marginRight="21dp"
					android:paddingLeft="16dp"
					android:paddingTop="21dp"
					android:paddingRight="16dp"
					android:paddingBottom="21dp"
					android:background="#363637"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:visibility="gone"
					android:elevation="6dp">
					<TextView
						android:id="@+id/titlepaused"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Chat Paused"
						android:textSize="30sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
					<TextView
						android:id="@+id/subtitlepaused"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Now chat is paused"
						android:textSize="14sp"
						android:textColor="#9E9E9E" />
					<TextView
						android:id="@+id/messagepaused"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Click start for Chat again with &quot;Elicia Livechat&quot;"
						android:textSize="14sp"
						android:textColor="#F5F5F5" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/control_livechat_button_background"
				android:layout_width="match_parent"
				android:layout_height="160dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/control_startlivechat_background"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/button_startlivechat_background"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="3dp"
						android:padding="8dp"
						android:orientation="horizontal">
						<ProgressBar
							android:id="@+id/progress_livechat"
							android:layout_width="60dp"
							android:layout_height="60dp"
							android:padding="8dp"
							android:background="#363637"
							android:indeterminate="false"
							style="?android:progressBarStyle"
							android:visibility="gone" />
						<ImageView
							android:id="@+id/start_button"
							android:layout_width="60dp"
							android:layout_height="60dp"
							android:padding="13dp"
							android:background="#363637"
							android:src="@drawable/ic_model"
							android:scaleType="fitXY" />
					</LinearLayout>
					<TextView
						android:id="@+id/indicator_startlivechat"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Start"
						android:textSize="14sp"
						android:textColor="#FFFFFF" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/control_closelivechat_background"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="30dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/button_closelivechat_background"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="3dp"
						android:padding="8dp"
						android:orientation="horizontal">
						<ImageView
							android:id="@+id/close_button"
							android:layout_width="60dp"
							android:layout_height="60dp"
							android:src="@drawable/ic_close"
							android:scaleType="fitXY" />
					</LinearLayout>
					<TextView
						android:id="@+id/indicator_close"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="End"
						android:textSize="14sp"
						android:textColor="#FFFFFF" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
